root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,js,ts,jsx,tsx}]
indent_size = 2

[*.{css,scss}]
indent_size = 2

[*.html]
indent_size = 2

[*.{lock,lockfile}]
insert_final_newline = false
trim_trailing_whitespace = false
